{
  "name": "todorant-vnext",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm -r build",
    "budget": "pnpm --filter @todorant/web budget",
    "db:check": "pnpm --filter @todorant/api db:check",
    "db:migrate": "pnpm --filter @todorant/api db:migrate",
    "dev": "pnpm --filter @todorant/domain build && pnpm --parallel --filter @todorant/api --filter @todorant/web dev",
    "lint": "eslint .",
    "security:deps": "pnpm audit --prod --audit-level high",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm security:deps && pnpm build && pnpm db:check && pnpm budget"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "globals": "17.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
