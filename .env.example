NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://todorant:todorant@localhost:5432/todorant
BOSS_DATABASE_URL=postgresql://todorant:todorant@localhost:5432/todorant
# Production only: a migration administrator URL and independent 32+ character role passwords.
MIGRATION_DATABASE_URL=postgresql://todorant:todorant@localhost:5432/todorant
DATABASE_RUNTIME_PASSWORD=replace-with-at-least-32-random-characters
DATABASE_BOSS_PASSWORD=replace-with-another-32-character-secret
SESSION_PEPPER=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://localhost:5173
API_UPSTREAM=http://api:3000
# Deployment owner only: use a Mongo user with read-only role and keep readPreference=secondaryPreferred.
LEGACY_MONGO_URL=
LEGACY_MONGO_DATABASE=todorant
